{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bowling-game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "trumpagotchi",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "trumpagotchi/server.mjs"
      ],
      "env": {
        "CLOUD_STORE": "memory"
      },
      "port": 8080,
      "autoPort": true
    }
  ]
}
